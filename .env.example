# ============================================================
# GramFin — Environment Variables Template
# ============================================================
# Copy this file to .env (which is .gitignore'd) and fill in your values.
# Then run: node scripts/generate-config.js
#
# On Vercel: add these same variable names under
#   Project → Settings → Environment Variables
# ============================================================

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# ============================================================
# SECURITY NOTE
# The SUPABASE_ANON_KEY is the public "anon" key — it is safe
# to use in browser code. Supabase's Row Level Security (RLS)
# policies control what it can access (read-only for public
# tables; users can only read/write their own private data).
#
# NEVER put the "service_role" key here or anywhere in this repo.
# ============================================================
